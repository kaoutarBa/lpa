# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Cloud → App settings → Secrets.
# Never commit the real file. Any provider with an empty key or model is skipped.
NVIDIA_API_KEY = ""
BUILD_BASE_URL = "https://integrate.api.nvidia.com/v1"
BUILD_MODEL = "mistralai/mistral-nemotron"
BUILD_ANALYSIS_MODEL = "nvidia/nemotron-3-super-120b-a12b"   # optional, falls back to BUILD_MODEL

GROQ_API_KEY = ""
GROQ_BASE_URL = "https://api.groq.com/openai/v1"
GROQ_CHAT_MODEL = "openai/gpt-oss-20b"
GROQ_STT_MODEL = "whisper-large-v3"

COACH_ORDER = "groq,build"   # coach tries these in order, then the cached answer

BREV_URL = ""             # optional, vLLM server URL (add "brev" to COACH_ORDER to use it)
BREV_MODEL = ""
