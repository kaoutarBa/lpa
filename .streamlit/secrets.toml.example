# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Cloud → App settings → Secrets.
# Never commit the real file. Any provider left empty is skipped.
NVIDIA_API_KEY = ""
BUILD_BASE_URL = "https://integrate.api.nvidia.com/v1"
BUILD_MODEL = ""          # e.g. a chat model id from build.nvidia.com
GROQ_API_KEY = ""
GROQ_BASE_URL = "https://api.groq.com/openai/v1"
GROQ_CHAT_MODEL = ""      # e.g. a chat model id from console.groq.com
GROQ_STT_MODEL = "whisper-large-v3-turbo"
BREV_URL = ""             # optional, vLLM server URL
BREV_MODEL = ""
